{
	"name": "GoSSSD Development",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go",
				"redhat.vscode-yaml"
			],
			"settings": {
				"go.toolsManagement.checkForUpdates": "local",
				"go.useLanguageServer": true,
				"go.gopath": "/go"
			}
		}
	},
	"postCreateCommand": "bash .devcontainer/setup.sh",
	"remoteUser": "vscode",
	"features": {}
}
